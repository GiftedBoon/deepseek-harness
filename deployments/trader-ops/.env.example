# Copy values into an untracked local file for development or into
# /etc/deepseek-harness/trader-ops.env (mode 0600) on a server.

TRADER_OPS_PROFILE=web
DSH_HOME=/var/lib/deepseek-harness

# Start from a read-only Harness sandbox. Raise this only after the effective
# profile and the deployment's tool guards have been reviewed.
DSH_PERMISSION_MODE=read-only

# Choose default or aihubmix. The default keeps the model from the selected DSH
# Profile; aihubmix loads the deployment's OpenAI-compatible model patch.
TRADER_OPS_LLM_PROVIDER=default

# Harness and the OpenViking VLM share this OpenAI-compatible route. Keep the
# real key only in the mode-0600 deployment environment file.
AIHUBMIX_BASE_URL=https://gateway.example/v1
AIHUBMIX_API_KEY=replace-at-deploy-time
AIHUBMIX_MODEL=replace-at-deploy-time
AIHUBMIX_CONTEXT_WINDOW=65536
AIHUBMIX_MAX_TOKENS=4096

# This multi-platform digest is the OpenViking build validated by the MVP.
# Review and update it deliberately when upgrading OpenViking.
OPENVIKING_IMAGE=ghcr.io/volcengine/openviking@sha256:68394a4ed13f60e3c0644adda97c16bb1094c8261e12fc2e9e69d5aefaea3da1
OPENVIKING_HOME=/var/lib/openviking
OPENVIKING_SERVER_PORT=1933
OPENVIKING_URL=http://127.0.0.1:1933

# Ollama runs natively on both MVP hosts. Docker Desktop supplies this name on
# macOS; Compose maps it to Docker's bridge gateway on Linux.
OPENVIKING_OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENVIKING_EMBEDDING_MODEL=qwen3-embedding:0.6b
OPENVIKING_QUERY_PLANNER_MODEL=guoxuter/ov_intent_analysis_sft:v7_q8

# Never commit either real value. The root key controls account administration;
# the user key scopes Harness and data commands to the configured account/user.
OPENVIKING_ROOT_API_KEY=replace-at-deploy-time
OPENVIKING_API_KEY=
OPENVIKING_WITH_BOT=0

# Keep shared-memory behaviour explicit. The plugin also accepts
# OPENVIKING_ACCOUNT and OPENVIKING_USER when per-user identity is required.
OPENVIKING_PEER_ID=trader-ops
OPENVIKING_WORKSPACE_PEER=0
OPENVIKING_RECALL_PEER_SCOPE=actor

# Reserved for the future Trader Ops business MCP server. The example patch is
# not loaded by default, so these values do not enable a server on their own.
TRADER_OPS_MCP_ENABLED=0
TRADER_OPS_MCP_URL=http://127.0.0.1:1940/mcp
TRADER_OPS_MCP_TOKEN=replace-at-deploy-time
# Required by the fail-closed tool policy; choose development, staging, or production.
TRADER_OPS_ENVIRONMENT=development

# Optional enterprise WeCom intelligent-bot long connection. Keep it disabled
# until exact user ids and both secrets are stored outside Git.
TRADER_OPS_WECOM_ENABLED=0
TRADER_OPS_WECOM_SANDBOX=read-only
WECOM_BOT_ID=
WECOM_BOT_SECRET=
WECOM_SESSION_KEY=
WECOM_ALLOWED_USERS=
WECOM_ALLOWED_CHATS=
WECOM_GROUP_CONVERSATION_MODE=shared
