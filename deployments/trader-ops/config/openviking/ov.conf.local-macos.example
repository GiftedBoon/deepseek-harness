{
  "storage": {
    "workspace": "/app/.openviking/data"
  },
  "embedding": {
    "dense": {
      "provider": "ollama",
      "model": "${OPENVIKING_EMBEDDING_MODEL}",
      "api_base": "${OPENVIKING_OLLAMA_BASE_URL}/v1",
      "dimension": 1024,
      "input": "text"
    }
  },
  "vlm": {
    "provider": "litellm",
    "model": "ollama/${OPENVIKING_VLM_MODEL}",
    "api_key": "no-key",
    "api_base": "${OPENVIKING_OLLAMA_BASE_URL}",
    "temperature": 0.0,
    "max_retries": 2,
    "extra_request_body": {
      "num_ctx": 16384,
      "think": false
    }
  },
  "query_planner": {
    "provider": "litellm",
    "model": "ollama/${OPENVIKING_QUERY_PLANNER_MODEL}",
    "api_key": "no-key",
    "api_base": "${OPENVIKING_OLLAMA_BASE_URL}",
    "temperature": 0.0,
    "timeout": 60,
    "extra_request_body": {
      "think": false
    }
  },
  "server": {
    "host": "0.0.0.0",
    "port": 1933,
    "root_api_key": "${OPENVIKING_ROOT_API_KEY}"
  }
}
